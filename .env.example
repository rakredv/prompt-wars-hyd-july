# MindYou Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change_this_to_a_random_string_in_production

# Database
# Railway PostgreSQL: set automatically by Railway addon
# For local dev: leave blank to use SQLite (database.db)
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Apple Health Webhook Secret
# Set a random string here — add same value as header x-api-key in your iOS Shortcut
HEALTH_API_KEY=change_this_to_a_random_secret
