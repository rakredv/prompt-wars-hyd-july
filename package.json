{
  "name": "mindyou",
  "version": "1.0.0",
  "description": "GenAI-powered habit reduction app with Apple Health integration",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite --port 5173",
    "build": "vite build --outDir server/public --emptyOutDir",
    "start": "NODE_ENV=production node server/index.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "openai": "^4.47.1",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "puppeteer": "^25.3.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
